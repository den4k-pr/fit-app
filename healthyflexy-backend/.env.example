# ============ App ============
NODE_ENV=development
PORT=8080
API_GLOBAL_PREFIX=api/v1
# Railway стоїть за проксі — потрібно для коректного req.ip (rate limit OTP)
TRUST_PROXY=true
CORS_ORIGINS=http://localhost:8081
SWAGGER_ENABLED=true
APP_DEEP_LINK_SCHEME=healthyflexy

# ============ Database (Railway: підставити Reference ${{Postgres.DATABASE_URL}}) ============
DATABASE_URL=postgresql://postgres:kZyPlOcPymZNfbeYjSvqWOvzZHicDUbS@postgres.railway.internal:5432/railway
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_POOL_MAX=10
# true = застосовувати міграції при старті застосунку (зручно для Railway)
DB_RUN_MIGRATIONS=true

# ============ Auth ============
# openssl rand -base64 48
JWT_ACCESS_SECRET=KsZ92yRYekBi2qZBoOggyqSN2hGBr3heUIDhcyXeIFP3IJmaP03OzLoO2A2rYyXi
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# "перець" для хешування OTP та refresh-токенів (HMAC-SHA256)
TOKEN_HASH_SECRET=qNdmFvpb7h5WVoMl0OHfAMDpVphQfL+ayndA9knZAwuHkYDR0fBu8jovci5X5/OS

# ============ SMS (OTP) ============
# console = код друкується в лог (тільки dev), twilio = реальні SMS
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ============ Object storage (S3-compatible: AWS S3 eu-central-1 / Cloudflare R2 / Railway Bucket) ============
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET_PHOTOS=healthyflexy-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Публічна база для демо-відео вправ (окремий публічний bucket/CDN)
DEMO_VIDEOS_BASE_URL=

# ============ AI (vision-аналіз скріншотів вправи) ============
# stub = детермінований фейковий результат без ключа (dev), openai = GPT-4o Vision (потрібен OPENAI_API_KEY)
AI_PROVIDER=stub
OPENAI_API_KEY=
AI_MODEL=gpt-4o
AI_SCORE_THRESHOLD=60

# ============ Push ============
EXPO_ACCESS_TOKEN=

# ============ Rate limiting (глобально) ============
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ============ Monitoring (optional) ============
SENTRY_DSN=


RAILWAY_RUN_UID=0
STORAGE_LOCAL_DIR=/data/storage

PUBLIC_BASE_URL=https://healthyflexy-backend-production.up.railway.app/
# ============ CRM (адмінка healthyflexy-admin) ============
# Єдиний адмін-акаунт. Без цих двох змінних адмін-вхід вимкнено.
ADMIN_EMAIL=admin@example.com
# Мінімум 10 символів. Зміна пошти/пароля одразу виводить адміна з усіх сесій.
ADMIN_PASSWORD=change-me-to-a-long-password
# Необовʼязково (≥ 32 символи): окремий секрет для адмін-токенів; за замовчуванням виводиться з JWT_ACCESS_SECRET
ADMIN_JWT_SECRET=
# Адреса(и) сайту CRM через кому — для CORS
ADMIN_CORS_ORIGINS=http://localhost:5174

# Вхід через Google (Gmail): OAuth Client ID через кому (web, Android, iOS). Порожньо = вимкнено
GOOGLE_CLIENT_IDS=

# ============ Пошта: підтвердження пошти кодом (реєстрація й вхід) ============
# Розробка: console (лист друкується в лозі). Production: ЛИШЕ resend (console там відмовляє).
EMAIL_PROVIDER=console
# Resend → API Keys → Create (Sending access), ключ починається з re_
RESEND_API_KEY=
# Адреса на вашому домені, підтвердженому в Resend (Domains → Verified), напр. auth@mail.your-domain.com
MAIL_FROM=
MAIL_FROM_NAME=Книжка турботи

# ============ SMS: вхід за номером телефону (docs/SMS.md) ============
# Розробка: console (SMS у лозі). Production: smsapi (найдешевше для PL/UA) або twilio
SMSAPI_TOKEN=
SMSAPI_SENDER=
SMSAPI_URL=https://api.smsapi.com

# ============ Гроші: Stripe (docs/PAYMENTS.md). Порожньо = оплати вимкнено, лишається облік ============
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_MERCHANT_COUNTRY=PL
STRIPE_CONNECT_DEFAULT_COUNTRY=PL
STRIPE_MERCHANT_NAME=Książeczka troski

# ============ Підписка: App Store / Google Play (docs/PAYMENTS.md) ============
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_IAP_ENVIRONMENT=Sandbox
APPLE_ROOT_CERTS_DIR=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_RTDN_TOKEN=

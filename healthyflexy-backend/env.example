# Локально для `npx expo start`. Для EAS-збірок значення беруться з eas.json.
# Застосунок працює ЛИШЕ з бекендом. Найпростіше: сервер на Railway (https, телефон бачить його з будь-якої мережі):
#   EXPO_PUBLIC_API_URL=https://<ваша адреса>.up.railway.app/api/v1   (див. healthyflexy-backend/docs/RAILWAY.md)
# Локальний сервер: адреса залежить від того, де запущено застосунок:
#   iOS-симулятор / web:  http://localhost:3000/api/v1
#   Android-емулятор:     http://10.0.2.2:3000/api/v1
#   Реальний телефон:     http://<IP комп'ютера в Wi-Fi>:3000/api/v1   (на бекенді PUBLIC_BASE_URL — теж цей IP)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_WS_URL=http://localhost:3000
APP_ENV=development
EAS_PROJECT_ID=

# Вхід через Google (Gmail): OAuth Client ID через кому (web, Android, iOS). Порожньо = вимкнено
GOOGLE_CLIENT_IDS=

# ============ Пошта: підтвердження пошти кодом (реєстрація й вхід) ============
# Розробка: console (лист друкується в лозі). Production: ЛИШЕ resend (console там відмовляє).
EMAIL_PROVIDER=console
# Resend → API Keys → Create (Sending access), ключ починається з re_
RESEND_API_KEY=
# Адреса на вашому домені, підтвердженому в Resend (Domains → Verified), напр. auth@mail.your-domain.com
MAIL_FROM=
MAIL_FROM_NAME=Книжка турботи

# ============ SMS: вхід за номером телефону (docs/SMS.md) ============
# Розробка: console (SMS у лозі). Production: smsapi (найдешевше для PL/UA) або twilio
SMS_PROVIDER=console
SMSAPI_TOKEN=
SMSAPI_SENDER=
SMSAPI_URL=https://api.smsapi.com

# ============ Гроші: Stripe (docs/PAYMENTS.md). Порожньо = оплати вимкнено, лишається облік ============
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_MERCHANT_COUNTRY=PL
STRIPE_CONNECT_DEFAULT_COUNTRY=PL
STRIPE_MERCHANT_NAME=Książeczka troski

# ============ Підписка: App Store / Google Play (docs/PAYMENTS.md) ============
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_IAP_ENVIRONMENT=Sandbox
APPLE_ROOT_CERTS_DIR=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_RTDN_TOKEN=

{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://healthyflexy-backend-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_WS_URL": "https://healthyflexy-backend-production.up.railway.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://healthyflexy-backend-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_WS_URL": "https://healthyflexy-backend-production.up.railway.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://healthyflexy-backend-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_WS_URL": "https://healthyflexy-backend-production.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

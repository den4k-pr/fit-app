# Локально для `npx expo start`. Для EAS-збірок значення беруться з eas.json.
# Android-емулятор бачить хост-машину як 10.0.2.2, iOS-симулятор — localhost,
# реальний телефон — IP комп'ютера в Wi-Fi (http://192.168.x.x:3000).
EXPO_PUBLIC_API_URL=https://healthyflexy-backend-production.up.railway.app/api/v1
EXPO_PUBLIC_WS_URL=https://healthyflexy-backend-production.up.railway.app
APP_ENV=development
EAS_PROJECT_ID=
# Вхід через Google (Gmail): OAuth Client ID з Google Cloud Console → Credentials.
# Ті самі ID — у GOOGLE_CLIENT_IDS на сервері. Порожньо — кнопки «Увійти через Google» немає.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Apple Pay через Stripe: Merchant ID з Apple Developer (той самий — у Stripe → Settings → Apple Pay)
STRIPE_APPLE_MERCHANT_ID=
EXPO_PUBLIC_STRIPE_APPLE_MERCHANT_ID=
